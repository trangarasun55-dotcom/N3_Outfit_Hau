# Mẫu cấu hình: sao chép thành .env rồi điền bí mật trên máy cá nhân.
# Ứng dụng chỉ nạp .env; không lưu khóa thật trong file mẫu.
API_URL=http://127.0.0.1:8000
# Để trống: hệ thống tự tạo và lưu khóa ở data/.secret_key. Hoặc đặt chuỗi ngẫu nhiên dài.
SECRET_KEY=
# Khóa Gemini lấy tại https://aistudio.google.com (để trống: dùng lời giải thích theo quy tắc)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Để trống cả hai biến để bỏ qua seed admin. Muốn tạo admin, hãy cấu hình cả hai;
# mật khẩu phải dài 12-128 ký tự và không dùng mật khẩu mẫu trên hệ thống thật.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_MAX_AGE_SECONDS=43200
COOKIE_SECURE=0
DB_PATH=data/app.db
DEFAULT_CITY=Hà Nội
TEMP_MODE=current
OPEN_METEO_PROXY=
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
